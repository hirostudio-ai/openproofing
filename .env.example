# =============================================================================
# OpenProofing Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# --- Database ---
OPENPROOFING_DATABASE_URL="postgresql://openproofing:openproofing_dev@localhost:5432/openproofing?schema=public"

# --- Redis (BullMQ) ---
OPENPROOFING_REDIS_URL="redis://localhost:6379"

# --- Object Storage (S3-compatible / MinIO) ---
OPENPROOFING_S3_ENDPOINT="http://localhost:9000"
OPENPROOFING_S3_REGION="us-east-1"
OPENPROOFING_S3_BUCKET="openproofing"
OPENPROOFING_S3_ACCESS_KEY="openproofing"
OPENPROOFING_S3_SECRET_KEY="openproofing_dev"
OPENPROOFING_S3_FORCE_PATH_STYLE="true"

# --- Application ---
OPENPROOFING_APP_URL="http://localhost:3000"
OPENPROOFING_LOG_LEVEL="debug"

# --- Auth.js ---
AUTH_SECRET="generate-a-random-secret-for-production"
AUTH_URL="http://localhost:3000"

# --- Email (Resend or equivalent) ---
# OPENPROOFING_EMAIL_FROM="OpenProofing <noreply@example.com>"
# OPENPROOFING_RESEND_API_KEY=""

# --- Node ---
NODE_ENV="development"
